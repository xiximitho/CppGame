root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cpp,h,hpp}]
indent_size = 4
max_line_length = 84

[*.{cmake,txt}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is significant in Markdown line breaks.
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[*.ps1]
# PowerShell tooling on Windows defaults to CRLF.
end_of_line = crlf
indent_size = 4
